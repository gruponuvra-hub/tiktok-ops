# ---------------------------------------------------------------------------
# TikTok Business API — app de desenvolvedor (business-api.tiktok.com)
# Só preencher depois que o cadastro for aprovado. Ver CLAUDE.md > Estado do cadastro.
# ---------------------------------------------------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Marketing API (anúncios). Token de longa duração — não expira, não tem refresh.
TIKTOK_ADVERTISER_ID=
TIKTOK_MARKETING_ACCESS_TOKEN=

# Accounts API (orgânico). business_id é o open_id devolvido no OAuth da conta.
# Access token vale 24h; refresh token vale 1 ano.
TIKTOK_BUSINESS_ID=
TIKTOK_ACCOUNTS_ACCESS_TOKEN=
TIKTOK_ACCOUNTS_REFRESH_TOKEN=

# Business Center (multi-operação / agência)
TIKTOK_BC_ID=

# ---------------------------------------------------------------------------
# Cloudflare R2 — hospedagem das mídias servidas para a TikTok
# O domínio público precisa estar verificado como propriedade de URL na TikTok.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tiktok-media
# Sem barra no final. Precisa ser HTTPS e NÃO pode redirecionar.
R2_PUBLIC_BASE_URL=https://media.seudominio.com.br

# ---------------------------------------------------------------------------
# Google Drive — origem das mídias
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=./data/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------------
TIKTOK_OPS_ENV=dev
TIKTOK_OPS_DRY_RUN=true
